# Reality Estates — Production Environment Configuration
# Copy this file to .env.local and provide your public Supabase project values.

# Optional custom REST API base URL
VITE_API_BASE_URL=

# Required Supabase Project URL & Public Publishable Key
# Security Note: NEVER expose SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, or database passwords in VITE_ variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
VITE_SUPABASE_STORAGE_BUCKET=property-images
