# VITE_API_BASE_URL: Optional base URL for custom REST API endpoints
# Leave empty when using Supabase client services or local demo mode.
VITE_API_BASE_URL=

# Supabase Client Configuration (Public / Browser-Safe)
# Only use your project URL and public publishable (or anon) key here.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, or database passwords in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_STORAGE_BUCKET=property-images
